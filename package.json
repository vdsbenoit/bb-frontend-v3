{
  "name": "baden-app",
  "version": "0.5.3",
  "private": true,
  "description": "Baden Battle Score App",
  "scripts": {
    "dev": "vite",
    "build": "ionic-build-info && vite build",
    "build:patch": "npm version patch --no-git-tag-version && ionic-build-info && vite build",
    "build:minor": "npm version minor --no-git-tag-version && ionic-build-info && vite build",
    "build:major": "npm version major --no-git-tag-version && ionic-build-info && vite build",
    "preview": "vite preview",
    "test:unit": "vitest --run --passWithNoTests",
    "test:e2e": "cypress run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy:login": "firebase login --reauth",
    "deploy": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.3.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/status-bar": "8.0.2",
    "@ionic/pwa-elements": "^3.4.0",
    "@ionic/vue": "^8.8.3",
    "@ionic/vue-router": "^8.8.3",
    "@vueuse/core": "^14.2.1",
    "@vueuse/router": "^14.2.1",
    "core-js": "^3.49.0",
    "dompurify": "^3.3.3",
    "firebase": "^12.12.0",
    "semver": "^7.7.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vuefire": "^3.2.2",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.1.1",
    "@capacitor/cli": "8.3.0",
    "@eslint/css": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^15.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "ionic-build-info": "^0.0.8",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  }
}
